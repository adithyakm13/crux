{
  "name": "crux-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "test": "node --test \"packages/*/test/**/*.test.ts\"",
    "clean": "tsc --build --clean",
    "corpus": "node packages/corpus-tools/src/cli.ts",
    "bench": "node bench/pipeline.bench.ts",
    "bench:quick": "node bench/pipeline.bench.ts --quick",
    "console": "pnpm --filter @cruxci/console run dev",
    "console:build": "pnpm --filter @cruxci/console run build",
    "snapshot": "node packages/corpus-tools/src/cli.ts snapshot --out apps/console/public/corpus.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "@cruxci/core": "workspace:*",
    "@cruxci/engine": "workspace:*",
    "@cruxci/adapter-junit": "workspace:*"
  }
}
